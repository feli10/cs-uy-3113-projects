#include "CS3113/cs3113.h"

// Global Constants

constexpr int FPS = 60;
constexpr char BG_COLOUR[] = "#B2AAC6";

// Global Variables
int gWindowWidth;
int gWindowHeight;
AppStatus gAppStatus = RUNNING;
float gPreviousTicks = 0.0f;

int gCycler = 0.0f;

// Function Declarations
void initialise();
void processInput();
void update();
void render();
void shutdown();

// Function Definitions
void initialise() {
    InitWindow(800, 450, "Project 1");

    int monitor = GetCurrentMonitor();
    gWindowWidth  = GetMonitorWidth(monitor)  / 2;
    gWindowHeight = GetMonitorHeight(monitor) / 2;

    SetWindowSize(gWindowWidth, gWindowHeight);
    SetWindowPosition(
        (GetMonitorWidth(monitor)  - gWindowWidth)  / 2,
        (GetMonitorHeight(monitor) - gWindowHeight) / 2
    );

    SetTargetFPS(FPS);
}

void processInput() {
    if (WindowShouldClose()) gAppStatus = TERMINATED;
}

void update() {
    float ticks = GetTime();
    float deltaTime = ticks - gPreviousTicks;
    gPreviousTicks = ticks;
    gCycler = (gCycler + 1) % 360;
}

void render() {
    BeginDrawing();

    ClearBackground(ColorFromHex(BG_COLOUR));

    DrawCircle(100, 100, 50, BLUE);

    DrawPoly({gWindowWidth / 2.0f, gWindowHeight / 2.0f}, 4, 100.0f, gCycler, RED);

    EndDrawing();
}

void shutdown() {
    CloseWindow();
}

int main(void) {
    initialise();

    while (gAppStatus == RUNNING) {
        processInput();
        update();
        render();
    }

    shutdown();

    return 0;
}
